from sklearn.ensemble import RandomForestClassifier


import pandas as pd


data = pd.read_excel("IrisTest.xlsx")


x = data.iloc[:, :-1]


y = data.iloc[:,-1]


model = RandomForestClassifier()


model.fit(x.values, y.values)


predictions = model.predict([[114,	5.7,	2.5,	5,	2]])


print(predictions)


data_test = pd.read_excel("IrisTest.xlsx")


x_test = data_test.iloc[:,:-1]


predictions = model.predict(x_test.values)


predictions



